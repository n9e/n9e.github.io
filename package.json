{
  "name": "n9e-site",
  "version": "0.1.0",
  "private": true,
  "description": "Nightingale (夜莺) official website",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prebuild": "node scripts/fetch-stats.mjs || echo '⚠ 数字未刷新，沿用仓库中已有数值继续构建'; node scripts/fetch-releases.mjs || echo '⚠ 发布信息未刷新，沿用仓库中已有数据继续构建'; node scripts/fetch-integrations.mjs || echo '⚠ 集成目录未刷新，沿用仓库中已有数据继续构建'",
    "integrations": "node scripts/fetch-integrations.mjs",
    "releases": "node scripts/fetch-releases.mjs",
    "stats": "node scripts/fetch-stats.mjs",
    "build": "docusaurus build",
    "postbuild": "node scripts/strip-nul.mjs build && node scripts/finalize-legacy-doc-urls.mjs && node scripts/finalize-slash-aliases.mjs && node scripts/check-legacy-doc-urls.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "write-translations": "docusaurus write-translations",
    "typecheck": "tsc",
    "scaffold": "node scripts/scaffold-docs.mjs",
    "test:legacy-doc-urls": "node --test scripts/legacy-doc-urls.test.mjs",
    "check:legacy-doc-urls": "node scripts/check-legacy-doc-urls.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "^3.0.0",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "cheerio": "1.0.0-rc.12",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
